
{
  "entities": {
    "Product": {
      "title": "Producto",
      "description": "Entidad que representa una prenda o producto de la tienda",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "suggestions_ids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["name", "price", "stock", "category"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Colección global de productos del catálogo"
    }
  }
}
